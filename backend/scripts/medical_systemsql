--
-- Table structure for table `exposure_scoring_detail`
--

DROP TABLE IF EXISTS `exposure_scoring_detail`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `exposure_scoring_detail` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `allergen_product_id` bigint NOT NULL,
  `age_score` int DEFAULT NULL COMMENT '年龄维度评分(1-4分)',
  `product_form_score` int DEFAULT NULL COMMENT '产品形态维度评分(1-4分)',
  `content_score` int DEFAULT NULL COMMENT '含量维度评分(1-4分)',
  `frequency_score` int DEFAULT NULL COMMENT '使用频率维度评分(1-4分)',
  `duration_score` int DEFAULT NULL COMMENT '使用时间维度评分(1-4分)',
  `total_score` int DEFAULT NULL COMMENT '总分(5-20分)',
  `created_at` datetime NOT NULL,
  `updated_at` datetime NOT NULL,
