--
-- Table structure for table `news_filter`
--

DROP TABLE IF EXISTS `news_filter`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `news_filter` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `source` varchar(32) NOT NULL,
  `source_wz` varchar(32) DEFAULT NULL COMMENT '来源日报',
  `title` varchar(64) NOT NULL COMMENT '标题',
  `search_keyword` text NOT NULL COMMENT '搜索关键字',
  `publish_time` datetime DEFAULT NULL COMMENT '发布时间',
  `abstract` text COMMENT '关键信息',
  `link` varchar(255) DEFAULT NULL COMMENT '网站链接',
  `ai_relevance` varchar(32) DEFAULT NULL COMMENT 'ai分类',
  `ai_reason` text COMMENT 'ai分类的原因',
  `product` varchar(16) DEFAULT NULL COMMENT '产品',
  `symptom` varchar(128) DEFAULT NULL COMMENT '不良反应',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `news_filter_pk` (`id`),
  UNIQUE KEY `news_filter_pk_2` (`link`),
  KEY `idx_news_link_normalized` (`link`),
  KEY `idx_news_publish_time` (`publish_time`),
  FULLTEXT KEY `ft_news_title_abstract` (`title`)
) ENGINE=InnoDB AUTO_INCREMENT=133 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

