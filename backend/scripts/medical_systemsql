  `reference` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci COMMENT '参考文献',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `fk_toxicity_health_hazard_toxicity` (`toxicity_id`),
