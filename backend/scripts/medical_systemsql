  `id` bigint NOT NULL AUTO_INCREMENT,
  `toxicity_id` bigint NOT NULL COMMENT '毒性数据ID',
  `experiment_type` varchar(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT '实验类型',
